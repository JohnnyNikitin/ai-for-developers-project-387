{
  "name": "calendar-booking-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "npm run generate:openapi && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "generate:openapi": "../node_modules/.bin/tsp compile ../api --emit @typespec/openapi3 --output-dir ./.generated",
    "mock": "npm run generate:openapi && prism mock ./.generated/@typespec/openapi3/openapi.yaml --host 127.0.0.1 --port 4010 --cors",
    "dev:all": "concurrently -n mock,web -c cyan,magenta \"npm:mock\" \"npm:dev\""
  },
  "dependencies": {
    "@mantine/core": "^7.17.8",
    "@mantine/hooks": "^7.17.8",
    "lucide-react": "^0.468.0",
    "vite": "^5.4.12",
    "typescript": "^5.6.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@stoplight/prism-cli": "^5.14.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.1.0"
  }
}
