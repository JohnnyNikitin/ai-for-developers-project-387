import "@typespec/http";

using TypeSpec.Http;

@service({
  title: "Calendar Booking API",
  version: "1.0.0",
})
@doc("""
API contract for a booking calendar without registration or authorization.

There are two conditional roles:
- calendar owner: a single predefined profile used by the admin area by default;
- guest: an unauthenticated user who books a free slot without creating an account.

The service owns all availability decisions. A booking can be created only for a
free slot returned by the availability endpoint. Two bookings cannot have the
same start time, even if they belong to different event types.
""")
namespace CalendarBooking;

alias EventTypeId = string;
alias BookingId = string;

@doc("Predefined calendar owner profile used by the admin area.")
model CalendarOwnerProfile {
  id: string;
  displayName: string;
  email?: string;
}

@doc("Event type configured by the calendar owner.")
model EventType {
  @doc("Owner-defined stable identifier.")
  id: EventTypeId;

  @doc("Public event type name shown to guests.")
  name: string;

  @doc("Public event type description shown to guests.")
  description: string;

  @minValue(1)
  @doc("Event duration in minutes.")
  durationMinutes: int32;

  @doc("Server timestamp when the event type was created.")
  createdAt: utcDateTime;
}

@doc("Payload used by the calendar owner to create an event type.")
model CreateEventTypeRequest {
  @doc("Owner-defined stable identifier. Must be unique across event types.")
  id: EventTypeId;

  name: string;
  description: string;

  @minValue(1)
  @doc("Event duration in minutes.")
  durationMinutes: int32;
}

@doc("Guest-visible booking type projection.")
model BookingTypeSummary {
  id: EventTypeId;
  name: string;
  description: string;

  @minValue(1)
  durationMinutes: int32;
}

@doc("Free slot that can be booked by a guest.")
model AvailableSlot {
  @doc("Slot start timestamp in UTC.")
  startsAt: utcDateTime;

  @doc("Slot end timestamp in UTC, calculated from the event type duration.")
  endsAt: utcDateTime;
}

@doc("Availability window generated by the server.")
model AvailabilityWindow {
  eventTypeId: EventTypeId;

  @doc("Inclusive start of the booking window. Defaults to the current server date.")
  windowStartsOn: plainDate;

  @doc("Exclusive end of the booking window. Defaults to 14 days after windowStartsOn.")
  windowEndsOn: plainDate;

  @doc("Only free slots inside the 14-day window are returned.")
  slots: AvailableSlot[];
}

@doc("Guest contact data captured at booking time. It does not create an account.")
model GuestContact {
  name: string;
  email: string;
}

@doc("Payload used by a guest to create a booking.")
model CreateBookingRequest {
  eventTypeId: EventTypeId;

  @doc("""
  Start timestamp selected from the availability endpoint.
  The server rejects the request if the timestamp is outside the current
  14-day booking window or is no longer free.
  """)
  startsAt: utcDateTime;

  guest: GuestContact;
}

enum BookingStatus {
  confirmed,
  canceled,
}

@doc("Booking visible in both admin upcoming meetings and guest create response.")
model Booking {
  id: BookingId;
  eventTypeId: EventTypeId;
  eventTypeName: string;
  durationMinutes: int32;
  startsAt: utcDateTime;
  endsAt: utcDateTime;
  guest: GuestContact;
  status: BookingStatus;
  createdAt: utcDateTime;
}

enum ErrorCode {
  event_type_id_already_exists,
  event_type_not_found,
  slot_outside_booking_window,
  slot_not_available,
  validation_failed,
}

@error
model ErrorResponse {
  @statusCode
  statusCode: 400 | 404 | 409 | 422;

  code: ErrorCode;
  message: string;
}

model CreatedEventTypeResponse {
  @statusCode
  statusCode: 201;

  @body
  eventType: EventType;
}

model CreatedBookingResponse {
  @statusCode
  statusCode: 201;

  @body
  booking: Booking;
}

@route("/admin")
@doc("Administrative API used by the predefined calendar owner profile.")
namespace Admin {
  @route("/owner-profile")
  @doc("Returns the single predefined calendar owner profile used by the admin area.")
  @opExample(#{
    returnType: #{
      id: "owner-default",
      displayName: "Calendar Owner",
      email: "owner@example.com"
    }
  })
  @get
  op getOwnerProfile(): CalendarOwnerProfile;

  @route("/event-types")
  @doc("Creates an event type with owner-defined id, name, description and duration.")
  @opExample(#{
    parameters: #{
      request: #{
        id: "design-sync",
        name: "Design sync",
        description: "A focused session to align product and interface decisions.",
        durationMinutes: 45
      }
    },
    returnType: #{
      statusCode: 201,
      eventType: #{
        id: "design-sync",
        name: "Design sync",
        description: "A focused session to align product and interface decisions.",
        durationMinutes: 45,
        createdAt: utcDateTime.fromISO("2026-07-29T09:00:00Z")
      }
    }
  })
  @post
  op createEventType(@body request: CreateEventTypeRequest): CreatedEventTypeResponse | ErrorResponse;

  @route("/event-types")
  @doc("Lists all event types configured by the calendar owner.")
  @opExample(#{
    returnType: #[
      #{
        id: "intro-call",
        name: "Intro call",
        description: "A short meeting to understand the request and agree on next steps.",
        durationMinutes: 30,
        createdAt: utcDateTime.fromISO("2026-07-20T08:30:00Z")
      },
      #{
        id: "product-review",
        name: "Product review",
        description: "A detailed session about an interface, API, or product roadmap.",
        durationMinutes: 60,
        createdAt: utcDateTime.fromISO("2026-07-21T10:00:00Z")
      }
    ]
  })
  @get
  op listEventTypes(): EventType[];

  @route("/bookings/upcoming")
  @doc("""
  Lists upcoming confirmed bookings across all event types in one chronological list.
  Results are ordered by startsAt ascending.
  """)
  @opExample(#{
    returnType: #[
      #{
        id: "bk-1001",
        eventTypeId: "intro-call",
        eventTypeName: "Intro call",
        durationMinutes: 30,
        startsAt: utcDateTime.fromISO("2026-07-30T08:00:00Z"),
        endsAt: utcDateTime.fromISO("2026-07-30T08:30:00Z"),
        guest: #{ name: "Maria Orlova", email: "maria@example.com" },
        status: BookingStatus.confirmed,
        createdAt: utcDateTime.fromISO("2026-07-28T12:15:00Z")
      },
      #{
        id: "bk-1002",
        eventTypeId: "product-review",
        eventTypeName: "Product review",
        durationMinutes: 60,
        startsAt: utcDateTime.fromISO("2026-07-31T11:00:00Z"),
        endsAt: utcDateTime.fromISO("2026-07-31T12:00:00Z"),
        guest: #{ name: "Alex Petrov", email: "alex@example.com" },
        status: BookingStatus.confirmed,
        createdAt: utcDateTime.fromISO("2026-07-28T14:40:00Z")
      }
    ]
  })
  @get
  op listUpcomingBookings(): Booking[];
}

@route("/booking-types")
@doc("Public guest API for viewing available booking types.")
namespace BookingTypes {
  @doc("Lists guest-visible event types with name, description and duration.")
  @opExample(#{
    returnType: #[
      #{
        id: "intro-call",
        name: "Intro call",
        description: "A short meeting to understand the request and agree on next steps.",
        durationMinutes: 30
      },
      #{
        id: "product-review",
        name: "Product review",
        description: "A detailed session about an interface, API, or product roadmap.",
        durationMinutes: 60
      },
      #{
        id: "design-sync",
        name: "Design sync",
        description: "A focused session to align product and interface decisions.",
        durationMinutes: 45
      }
    ]
  })
  @get
  op list(): BookingTypeSummary[];

  @route("/{eventTypeId}/availability")
  @doc("""
  Returns free slots for the selected event type in the default booking window:
  14 days starting from the current server date.

  The response excludes all startsAt timestamps already occupied by any booking,
  regardless of event type.
  """)
  @opExample(#{
    parameters: #{ eventTypeId: "intro-call" },
    returnType: #{
      eventTypeId: "intro-call",
      windowStartsOn: plainDate.fromISO("2026-07-29"),
      windowEndsOn: plainDate.fromISO("2026-08-12"),
      slots: #[
        #{ startsAt: utcDateTime.fromISO("2026-07-30T08:00:00Z"), endsAt: utcDateTime.fromISO("2026-07-30T08:30:00Z") },
        #{ startsAt: utcDateTime.fromISO("2026-07-30T08:30:00Z"), endsAt: utcDateTime.fromISO("2026-07-30T09:00:00Z") },
        #{ startsAt: utcDateTime.fromISO("2026-07-31T10:00:00Z"), endsAt: utcDateTime.fromISO("2026-07-31T10:30:00Z") }
      ]
    }
  })
  @get
  op getAvailability(@path eventTypeId: EventTypeId): AvailabilityWindow | ErrorResponse;
}

@route("/bookings")
@doc("Public guest API for creating bookings without registration or login.")
namespace GuestBookings {
  @doc("""
  Creates a confirmed booking for a selected free slot.

  The server must reject the request when:
  - eventTypeId does not exist;
  - startsAt is outside the current 14-day booking window;
  - another booking already has the same startsAt, even for another event type.
  """)
  @opExample(#{
    parameters: #{
      request: #{
        eventTypeId: "intro-call",
        startsAt: utcDateTime.fromISO("2026-07-30T08:30:00Z"),
        guest: #{ name: "Elena Smirnova", email: "elena@example.com" }
      }
    },
    returnType: #{
      statusCode: 201,
      booking: #{
        id: "bk-1003",
        eventTypeId: "intro-call",
        eventTypeName: "Intro call",
        durationMinutes: 30,
        startsAt: utcDateTime.fromISO("2026-07-30T08:30:00Z"),
        endsAt: utcDateTime.fromISO("2026-07-30T09:00:00Z"),
        guest: #{ name: "Elena Smirnova", email: "elena@example.com" },
        status: BookingStatus.confirmed,
        createdAt: utcDateTime.fromISO("2026-07-29T09:10:00Z")
      }
    }
  })
  @post
  op create(@body request: CreateBookingRequest): CreatedBookingResponse | ErrorResponse;
}
